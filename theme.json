				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "\"Montserrat\", sans-serif",
					"name": "Montserrat",
					"slug": "montserrat",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontWeight": "400 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/montserrat/v29/JTUHjIg1_i6t8kCHKm4532VJOt5-QNFgpCs16Hw5aXp-p7K4KLjztg.woff2"
